{
  "name": "personal-diary-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3111",
    "build": "next build",
    "start": "next start -p 3111",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "test:reset": "node scripts/reset-smoke.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed": "tsx scripts/seed.ts",
    "invite:new": "tsx scripts/invite.ts new",
    "invite:list": "tsx scripts/invite.ts list",
    "invite:revoke": "tsx scripts/invite.ts revoke",
    "setup": "node scripts/init-env.mjs && prisma db push && npm run seed",
    "discord": "tsx src/discord/bot.ts",
    "bot": "tsx src/discord/bot.ts",
    "discord:register": "tsx src/discord/register-commands.ts",
    "discord:link": "node scripts/link-discord.mjs",
    "discord:verify": "node scripts/verify-discord-token.mjs",
    "discord:audit": "node scripts/audit-discord-commands.mjs",
    "dm:test": "node scripts/test-dm.mjs",
    "cleanup": "node scripts/cleanup-verification.mjs",
    "deploy:migrate": "node scripts/deploy-migrate.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "verify:multiuser": "node scripts/verify-multiuser.mjs",
    "audit:scoping": "node scripts/audit-user-scoping.mjs",
    "worker": "tsx src/worker/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.4",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
