# ── Core ─────────────────────────────────────────────────────────────────────
# Local development uses SQLite (file resolved next to prisma/schema.prisma).
# For production switch prisma/schema.prisma datasource provider to
# "postgresql" and point this at a real Postgres URL.
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3111"

# 32+ byte random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me"

# First-run account, created by `npm run seed`. Change the password immediately.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="replace-me"
# Used for timezone-correct day buckets, streaks and warm-up jobs.
USER_TIMEZONE="Asia/Jakarta"

# ── Discord (optional until Phase 4) ─────────────────────────────────────────
# ⚠️ If you reuse a bot that another gateway already uses (e.g. the Hermes
# agent's Discord gateway), a SECOND gateway on the same token means both
# clients receive every DM. Keep DISCORD_CAPTURE_DMS unset unless you have a
# dedicated bot — slash commands work regardless.
DISCORD_BOT_TOKEN=""
DISCORD_APPLICATION_ID=""
# Channel that receives entry/reminder/reflection notifications.
DISCORD_NOTIFY_CHANNEL_ID=""
# Secret used to verify the interactions endpoint signature (Ed25519 public key
# is derived from the bot token by Discord; this value is the app's public key).
DISCORD_PUBLIC_KEY=""
# Guild for instant, non-destructive slash-command registration. Registration is
# guild-scoped by default because a global PUT overwrites every command in the
# application, including another bot's.
DISCORD_GUILD_ID=""
# "true" turns every DM from a linked user into a diary entry. Off by default.
DISCORD_CAPTURE_DMS=""

# ── AI (optional, Phase 8 — the app works without it) ────────────────────────
# When empty, AI features report "not configured" instead of faking output.
# Any OpenAI-compatible endpoint; AI_BASE_URL wins over AI_PROVIDER.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
