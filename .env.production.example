# Production environment template for a deployment (Oracle Cloud or any VPS).
# Copy to .env.production and fill in. NEVER commit the filled-in file.
#
#   cp .env.example .env.production
#
# The diary database lives OUTSIDE the app directory, on a mounted volume, so
# redeploying the container cannot destroy it:
#   Docker : DATABASE_URL="file:/data/diary.db"
#   pm2    : DATABASE_URL="file:/home/ubuntu/diary-data/diary.db"

# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL="file:/data/diary.db"
# Your public https URL (tunnel URL or custom domain). Used in Discord links.
APP_URL="https://your-tunnel-hostname.example"
# 32+ byte random string. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs everyone out — that is the point.
SESSION_SECRET=""

# Leave unset when serving over HTTPS (a tunnel, or a real domain with TLS).
# Set to "false" when the app is reached over PLAIN HTTP — e.g. a host that only
# gives you a port-80 subdomain. A `secure` cookie is refused by the browser over
# HTTP, so login would appear to succeed and then bounce back to /login forever.
# COOKIE_SECURE="false"

# ── Web binding (Docker Compose reads these) ─────────────────────────────────
# ⚠️ Docker Compose substitutes ${VAR} from the project's `.env` file, NOT from
# .env.production — that file is only read as the container's env_file. So put
# the two lines below in BOTH files, or export them inline:
#   WEB_BIND=0.0.0.0 WEB_PORT=80 docker compose up -d --build
#
# Default is loopback-only: expose the app through a tunnel.
# For dalang.io's free subdomain (which proxies to port 80) use:
#   WEB_BIND="0.0.0.0"
#   WEB_PORT="80"
# and set COOKIE_SECURE="false" above.
# WEB_BIND="0.0.0.0"
# WEB_PORT="80"

# Owner login, created once by scripts/deploy-migrate.mjs. Pick a long password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Operator of this instance: the only account allowed to mint invite codes.
# Leave blank to use ADMIN_EMAIL.
BETA_ADMIN_EMAIL=""
USER_TIMEZONE="Asia/Jakarta"

# ── Discord ──────────────────────────────────────────────────────────────────
# ⚠️ If this token belongs to a bot another gateway already uses, a second
# gateway here means BOTH receive every DM. Leave DISCORD_CAPTURE_DMS unset.
DISCORD_BOT_TOKEN=""
DISCORD_APPLICATION_ID=""
# Where notifications land. A DM channel id counts as a channel.
DISCORD_NOTIFY_CHANNEL_ID=""
# Required: command registration is guild-scoped so it cannot wipe another
# bot's commands. See README → "Two guardrails".
DISCORD_GUILD_ID=""
# Only set this on a dedicated bot.
# DISCORD_CAPTURE_DMS="true"
# Only needed for HTTP-interaction mode instead of the gateway.
DISCORD_PUBLIC_KEY=""

# ── AI (optional) ────────────────────────────────────────────────────────────
# Empty means AI features report "not configured" instead of faking output.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
